{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "node scripts/check-parcels.cjs && node scripts/generate-seo-files.cjs",
    "build": "vite build",
    "postbuild": "node scripts/prerender-routes.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "verify:parcels": "node scripts/check-parcels.cjs",
    "convert:videos": "bash scripts/convert-videos.sh",
    "audit:mobile": "npm run build && node scripts/build-mobile-audit.cjs && echo '→ Ouvrir public/mobile-audit-standalone.html'",
    "brochure": "node scripts/brochure/render.cjs",
    "brochure:previews": "swift scripts/pdf-to-jpg.swift public/pdf/Dun-Tni-Brochure-Premium.pdf public/pdf/plaquette 1100"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@puckeditor/core": "^0.23.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-font-family": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@vitejs/plugin-react": "^5.0.4",
    "dompurify": "^3.4.15",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
